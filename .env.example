# Optional browser QA overrides; export in the shell (no dotenv loader).
# Leave PREVIEW_URL unset for the self-contained loopback server.
# Remote QA accepts only an immutable draft URL for axiom-deploy.
PREVIEW_URL=https://DRAFT_DEPLOY_ID--axiom-deploy.netlify.app
# Leave unset for qa/remake/; use an absolute folder to preserve review evidence.
SCREENSHOT_DIR=/absolute/path/to/preview
# Netlify uses the saved CLI login; NETLIFY_AUTH_TOKEN must be UNSET.
